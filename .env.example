# ============================================
#       OTP BOT - ENVIRONMENT VARIABLES
#       Copy this to .env and fill values
# ============================================

# ── Telegram API ───────────────────────────────
API_ID=12345678
API_HASH=abcdef1234567890abcdef1234567890
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# ── Admin IDs (comma separated) ────────────────
ADMIN_IDS=123456789,987654321

# ── MongoDB ────────────────────────────────────
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/otpbot

# ── BharatPe ──────────────────────────────────
BHARATPE_TOKEN=your_bharatpe_api_token
BHARATPE_MERCHANT_ID=your_merchant_id
BHARATPE_UPI_ID=BHARATPE.8I0O0B6E7D63166@fbpe

# ── Support ────────────────────────────────────
SUPPORT_USERNAME=@your_support_handle
